<Window x:Class="UMapx.Video.RealSense.Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealSense.Example" Height="450" Width="800" MinHeight="300" MinWidth="500">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Depth" Grid.Column="1" FontWeight="SemiBold" Margin="8,0,0,8" />
        <Image x:Name="imgColor" Grid.Row="1" Margin="0,0,6,0" Stretch="Uniform" />
        <Image x:Name="imgDepth" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Stretch="Uniform" />
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText" Text="Connecting to RealSense camera..."
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button x:Name="reconnectButton" Grid.Column="1" Content="Reconnect" Padding="14,6"
                    VerticalAlignment="Center" Click="OnReconnect" />
        </Grid>
    </Grid>
</Window>
